  "tres_cambios_condicionales_claude": {
    "cambio_1_control_de_brillo": {
      "descripcion": "En analizar_salon.py, para cada par de la Parte 2 se calcula qué lado elegiría alguien que solo mire «el más claro o el más oscuro» (según la luminancia media CIE L* de cada mosaico: el observador guiado solo por brillo elige el lado más claro con tasa q_claro y el más oscuro con tasa q_oscuro = 1 - q_claro, además de la cota determinista max(acierto_si_elige_claro, acierto_si_elige_oscuro) ponderada por el salto de brillo |ΔL*|/30). Se informa qué neuronas aciertan MÁS que esa regla simple de brillo.",
      "criterio_se_siente_de_verdad": "Una neurona «se siente de verdad» si y solo si: (1) acierto_humano >= 70.0%, (2) p_ajustado_Holm < 0.05 sobre las 20 neuronas, y (3) acierto_humano > acierto_regla_simple_brillo (supera la regla simple de elegir solo por más claro o más oscuro)."
    },
    "cambio_2_sorteo_izquierda_derecha_por_persona": {
      "descripcion": "Izquierda y derecha se sortean por persona usando una semilla determinista derivada de su apodo normalizado (FNV-1a 32-bit de apodo.strip().lower() + 2810 -> PRNG mulberry32), manteniendo el equilibrio 10 izquierda / 10 derecha en las 20 neuronas, 2/2 en los controles al azar y 1/1 en atención.",
      "registro_en_json": "Cada respuesta en salon_respuesta_<apodo>.json guarda explícitamente semilla_apodo, lado_polo_pos_mostrado (\"izquierda\" o \"derecha\"), sha256_mostrado_izquierda, sha256_mostrado_derecha y eleccion (\"izquierda\" o \"derecha\")."
    },
    "cambio_3_separacion_corazones_bruno_vs_otros": {
      "descripcion": "Los ♥ de la Parte 4 solo cuentan para N-2 y D-8 si el apodo es el de Bruno (apodo.strip().lower() == \"bruno\"). Los ♥ de las demás personas se guardan y reportan en un archivo aparte (corazones_otros_participantes.json) sin mezclarse nunca con el vector de gusto de Bruno."
    }
  },
